// ─────────────────────────────────────────────
//  Prisma Schema — RiohachaMarket
//  Base de datos: PostgreSQL
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotifType {
  NEW_SALE
  ORDER_SHIPPED
  ORDER_DELIVERED
  NEW_REVIEW
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  PRICE_DROP
  LOW_STOCK
  POINTS_EARNED
  PROMO
}

enum PushChannel {
  WEB
  WHATSAPP
}

// ─── Modelos ──────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(BUYER)
  phone     String?
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  pushTokens    PushToken[]
  wishlist      WishlistItem[]

  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  products      Product[]
  subscriptions Subscription[]

  @@map("stores")
}

model Subscription {
  id        String             @id @default(uuid())
  storeId   String
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  wompiRef  String?
  createdAt DateTime           @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@map("subscriptions")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  slug        String   @unique
  description String?
  price       Int
  stock       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store      Store          @relation(fields: [storeId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlist   WishlistItem[]

  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Order {
  id        String      @id @default(uuid())
  buyerId   String
  total     Int
  status    OrderStatus @default(PENDING)
  wompiRef  String?
  address   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer      User        @relation(fields: [buyerId], references: [id])
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Int
  commission Int    @default(0)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  buyerId   String
  productId String
  rating    Int
  comment   String?
  points    Int      @default(10)
  createdAt DateTime @default(now())

  buyer   User    @relation(fields: [buyerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([buyerId, productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      NotifType
  title     String
  body      String
  isRead    Boolean   @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model PushToken {
  id        String      @id @default(uuid())
  userId    String
  token     String
  channel   PushChannel
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@map("push_tokens")
}

model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  title     String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}